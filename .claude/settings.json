{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/worktree-setup.js"],
            "timeout": 600,
            "statusMessage": "Preparing worktree (npm install + ports)..."
          }
        ]
      }
    ]
  }
}
